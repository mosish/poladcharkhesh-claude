# Copy to .env and fill in. Never commit the real .env.
#
# In production the two secrets below are mandatory: the application refuses to
# start without them rather than generating throwaway values that would rotate
# on every restart and sign every admin out.
#
# Generate each with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"

APP_ENV=development
APP_TIMEZONE=Asia/Tehran

APP_SESSION_SECRET=
APP_COOKIE_SECRET=

# Absolute path to the JSON data store. On cPanel this belongs OUTSIDE
# public_html — for example /home/<account>/polad-data
# APP_DATA_PATH=/home/youraccount/polad-data

# Set to true only when the application sits behind a proxy you control and
# that proxy sets X-Forwarded-For and X-Forwarded-Proto. Left false, those
# headers are ignored, so a client cannot spoof its own address or scheme.
APP_TRUST_PROXY=false
